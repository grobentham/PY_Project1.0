@echo off
setlocal EnableExtensions
cd /d "%~dp0"
title XAU V16 R7-R1 Full Runtime Repair

where py >nul 2>nul
if %errorlevel%==0 (
    set "PY=py -3"
) else (
    where python >nul 2>nul
    if errorlevel 1 (
        echo [BLOCKED] Python 3 was not found on PATH.
        pause
        exit /b 1
    )
    set "PY=python"
)

:MENU
cls
echo ============================================================
echo XAU V16 R7-R1 - FULL RUNTIME REPAIR
echo Frozen R6 package/state integrity is checked before MT5 use.
echo LIVE ACCOUNT EXECUTION IS PROHIBITED.
echo Raw/manual intents have NO order-send authority.
echo Autonomous decision execution is HARD-LOCKED in R7-R1
echo until the exact causal frozen-R6 producer is implemented/audited.
echo ============================================================
echo.
echo [1] Offline package + persistent-state integrity status
echo [2] MT5 account / quote / exposure status
echo [3] Crash-recovery reconciliation - NEVER AUTO-RESENDS
echo [4] Diagnostic raw-intent preflight - NO SEND
echo [5] Open frozen-R6 decision inbox folder - STAGING ONLY
echo [6] Show producer/execution readiness status
echo [7] Clear manual-review pause after MT5 review
echo [8] Producer certification tools - NO TRADING AUTHORITY
echo [0] Exit
echo.
set /p CHOICE=Select: 

if "%CHOICE%"=="1" (
    %PY% -m r7_runtime.runtime --offline-status
    goto PAUSEMENU
)
if "%CHOICE%"=="2" (
    %PY% -m r7_runtime.runtime --status
    goto PAUSEMENU
)
if "%CHOICE%"=="3" (
    %PY% -m r7_runtime.runtime --recover
    goto PAUSEMENU
)
if "%CHOICE%"=="4" (
    echo Diagnostic only. This path cannot send an order.
    set /p INTENT=Raw intent JSON path: 
    %PY% -m r7_runtime.runtime --preflight-intent "%INTENT%"
    goto PAUSEMENU
)
if "%CHOICE%"=="5" (
    if not exist "r7_r6_bridge\inbox" mkdir "r7_r6_bridge\inbox"
    echo STAGING ONLY: R7-R1 will not execute inbox decisions because the
    echo exact causal R6 producer is not yet admitted.
    start "" explorer.exe "%CD%\r7_r6_bridge\inbox"
    goto PAUSEMENU
)
if "%CHOICE%"=="6" (
    %PY% -m r7_runtime.runtime --offline-status
    goto PAUSEMENU
)
if "%CHOICE%"=="7" (
    echo.
    echo Resume is refused if MT5 still shows ANY XAU exposure or unresolved in-flight intent.
    echo Exact acknowledgement required:
    echo I_REVIEWED_MT5_AND_ACCEPT_RESUME
    set /p ACK=Type acknowledgement: 
    %PY% -m r7_runtime.runtime --clear-r6-pause --resume-ack "%ACK%"
    goto PAUSEMENU
)
if "%CHOICE%"=="8" (
    call :VERIFY_PRODUCER_TOOLKIT
    if errorlevel 1 goto PAUSEMENU
    goto PRODUCER_MENU
)
if "%CHOICE%"=="0" exit /b 0

echo [ERROR] Invalid selection.
goto PAUSEMENU

:PRODUCER_MENU
cls
echo ============================================================
echo R6 PRODUCER CERTIFICATION TOOLS - NO TRADING AUTHORITY
echo These tools cannot flip CAUSAL_R6_PRODUCER_READY and cannot
echo create an execution-enabled package.
echo Package/operator hashes are rechecked immediately before each tool.
echo ============================================================
echo.
echo [1] Probe canonical frozen R6 source implementation - SOURCE ONLY
echo [2] Extract canonical Python source dependency closure - SOURCE ONLY
echo [3] Seal completed producer candidate in isolated baseline copy
echo [4] Precheck sealed candidate for a FUTURE fused build
echo [0] Back
echo.
set /p PCHOICE=Select: 

if "%PCHOICE%"=="1" (
    call :VERIFY_PRODUCER_TOOLKIT
    if errorlevel 1 goto PRODUCER_PAUSE
    powershell.exe -NoProfile -ExecutionPolicy Bypass -File "%CD%\PROBE_CANONICAL_R6_SOURCE.ps1"
    goto PRODUCER_PAUSE
)
if "%PCHOICE%"=="2" (
    call :VERIFY_PRODUCER_TOOLKIT
    if errorlevel 1 goto PRODUCER_PAUSE
    powershell.exe -NoProfile -ExecutionPolicy Bypass -File "%CD%\EXTRACT_CANONICAL_R6_PRODUCER_SOURCE.ps1"
    goto PRODUCER_PAUSE
)
if "%PCHOICE%"=="3" (
    call :VERIFY_PRODUCER_TOOLKIT
    if errorlevel 1 goto PRODUCER_PAUSE
    echo Candidate must already contain the exact producer + complete parity/admission evidence.
    set /p CANDIDATE=Producer candidate folder path: 
    powershell.exe -NoProfile -ExecutionPolicy Bypass -File "%CD%\SEAL_R6_PRODUCER_CANDIDATE.ps1" -RuntimeRoot "%CD%" -CandidateRoot "%CANDIDATE%"
    goto PRODUCER_PAUSE
)
if "%PCHOICE%"=="4" (
    call :VERIFY_PRODUCER_TOOLKIT
    if errorlevel 1 goto PRODUCER_PAUSE
    echo This verifies eligibility only. It does NOT fuse code or unlock execution.
    set /p CANDIDATE=Sealed producer candidate folder path: 
    powershell.exe -NoProfile -ExecutionPolicy Bypass -File "%CD%\PRECHECK_R6_FUSED_RELEASE.ps1" -RuntimeRoot "%CD%" -CandidateRoot "%CANDIDATE%"
    goto PRODUCER_PAUSE
)
if "%PCHOICE%"=="0" goto MENU

echo [ERROR] Invalid producer-tool selection.

:PRODUCER_PAUSE
echo.
pause
goto PRODUCER_MENU

:VERIFY_PRODUCER_TOOLKIT
%PY% -m r7_runtime.runtime --offline-status >nul 2>nul
if errorlevel 1 (
    echo [BLOCKED] Package/operator integrity failed. Producer tools will not run.
    %PY% -m r7_runtime.runtime --offline-status
    exit /b 1
)
exit /b 0

:PAUSEMENU
echo.
pause
goto MENU
