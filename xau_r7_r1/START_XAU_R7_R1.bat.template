@echo off
setlocal EnableExtensions
cd /d "%~dp0"
title XAU V16 R7-R1 Full Runtime Repair

where py >nul 2>nul
if %errorlevel%==0 (
    set "PY=py -3"
) else (
    where python >nul 2>nul
    if errorlevel 1 (
        echo [BLOCKED] Python 3 was not found on PATH.
        pause
        exit /b 1
    )
    set "PY=python"
)

:MENU
cls
echo ============================================================
echo XAU V16 R7-R1 - FULL RUNTIME REPAIR
echo Frozen R6 package/state integrity is checked before MT5 use.
echo LIVE ACCOUNT EXECUTION IS PROHIBITED.
echo Raw/manual intents have NO order-send authority.
echo Automatic R6 decisions require the two-part DEMO unlock.
echo ============================================================
echo.
echo [1] Offline package + persistent-state integrity status
echo [2] MT5 account / quote / exposure status
echo [3] Crash-recovery reconciliation - NEVER AUTO-RESENDS
echo [4] Diagnostic raw-intent preflight - NO SEND
echo [5] Open frozen-R6 decision inbox folder
echo [6] Process one admitted R6 decision from inbox
echo [7] Drain current admitted R6 decision inbox
echo [8] Run automatic admitted R6 inbox loop
echo [9] Clear manual-review pause after MT5 review
echo [0] Exit
echo.
set /p CHOICE=Select: 

if "%CHOICE%"=="1" (
    %PY% -m r7_runtime.runtime --offline-status
    goto PAUSEMENU
)
if "%CHOICE%"=="2" (
    %PY% -m r7_runtime.runtime --status
    goto PAUSEMENU
)
if "%CHOICE%"=="3" (
    %PY% -m r7_runtime.runtime --recover
    goto PAUSEMENU
)
if "%CHOICE%"=="4" (
    echo Diagnostic only. This path cannot send an order.
    set /p INTENT=Raw intent JSON path: 
    %PY% -m r7_runtime.runtime --preflight-intent "%INTENT%"
    goto PAUSEMENU
)
if "%CHOICE%"=="5" (
    if not exist "r7_r6_bridge\inbox" mkdir "r7_r6_bridge\inbox"
    start "" explorer.exe "%CD%\r7_r6_bridge\inbox"
    goto MENU
)
if "%CHOICE%"=="6" (
    echo.
    echo This consumes ONLY a validated FROZEN_V16_R6 admitted-decision JSON.
    echo DEMO sending remains locked unless BOTH explicit unlocks are present.
    set /p DECISION=Decision filename already inside r7_r6_bridge\inbox: 
    %PY% -m r7_runtime.runtime --process-r6-decision "r7_r6_bridge\inbox\%DECISION%"
    goto PAUSEMENU
)
if "%CHOICE%"=="7" (
    echo DEMO sending remains locked unless BOTH explicit unlocks are present.
    %PY% -m r7_runtime.runtime --drain-r6-inbox
    goto PAUSEMENU
)
if "%CHOICE%"=="8" (
    echo.
    echo Automatic inbox execution is DEMO-ONLY and stops on any manual-review state.
    echo Press Ctrl+C to stop the loop.
    %PY% -m r7_runtime.runtime --run-r6-inbox
    goto PAUSEMENU
)
if "%CHOICE%"=="9" (
    echo.
    echo Resume is refused if MT5 still shows ANY XAU exposure or unresolved in-flight intent.
    echo Exact acknowledgement required:
    echo I_REVIEWED_MT5_AND_ACCEPT_RESUME
    set /p ACK=Type acknowledgement: 
    %PY% -m r7_runtime.runtime --clear-r6-pause --resume-ack "%ACK%"
    goto PAUSEMENU
)
if "%CHOICE%"=="0" exit /b 0

echo [ERROR] Invalid selection.

:PAUSEMENU
echo.
pause
goto MENU
